# Anthropic — leave unset to use deterministic template narratives
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SECONDS=20

# Detection
RISK_THRESHOLD=0.5

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false
MAX_TRANSACTIONS_PER_REQUEST=5000
# Comma-separated. Empty = same-origin only.
ALLOWED_ORIGINS=

# Rate limiting (per serverless instance)
LLM_RATE_LIMIT_PER_MINUTE=5
